{
  "$comment": "Purpose: demonstrate a reusable platform configuration; inspect the actual StorageClass, API CIDRs, and component readiness before planning.",
  "schema_version": 1,
  "environment_id": "example-dev",
  "cluster": {
    "type": "minikube",
    "mode": "reuse",
    "context": "minikube",
    "kubeconfig": "~/.kube/config"
  },
  "application": {
    "database": "example_app",
    "username": "example_app"
  },
  "postgres": {
    "enabled": true,
    "storage": "4Gi"
  },
  "kafka": {
    "enabled": true,
    "namespace": "kafka",
    "topics": ["example.jobs.v1", "example.jobs.dlq.v1"],
    "consumer_group": "example-worker",
    "storage": "4Gi"
  },
  "monitoring": {
    "enabled": true,
    "namespace": "monitoring",
    "release": "monitoring"
  },
  "storage": {
    "mode": "reuse",
    "class": "platform-local-retain"
  },
  "budget": {
    "max_memory_requests_mib": 2048,
    "min_disk_free_mib": 2048
  }
}
